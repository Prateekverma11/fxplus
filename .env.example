# Database Connection URL (PostgreSQL or SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fxpulse?schema=public"
# Or SQLite: "file:./dev.db"

# External Foreign Exchange API Configuration
FX_API_URL="https://open.er-api.com/v6"
FX_API_KEY="your_api_key_here"

# Server Port
PORT=5000
NODE_ENV=development

# Scheduled background data sync (Cron)
CRON_SCHEDULE="*/15 * * * *"
